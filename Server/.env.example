# after first login.
ADMIN_EMAIL=admin@fwu.edu.np
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator
ADMIN_SCHOOL_ID=ADM-001

# Client (for CORS)
CLIENT_ORIGIN=http://localhost:5173